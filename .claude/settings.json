{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git show:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(cargo fmt --check:*)",
      "Bash(cargo clippy:*)",
      "Bash(prettier --check:*)",
      "Bash(gh:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(cat:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-rust-policy.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/ts-guard.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/shell-guard.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty' 2>/dev/null); case \"${f##*/}\" in Cargo.lock|pnpm-lock.yaml|pnpm-lock.yml|bun.lockb|yarn.lock) echo '⚠️  Blocked: lock files are managed by the package manager — do not hand-edit.' >&2; exit 2;; esac"
          },
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty' 2>/dev/null); b=${f##*/}; case \"$b\" in .env.example|.env.sample|.env.template) exit 0;; .env|.env.*) echo '🔒 Blocked: .env holds secrets and must be edited manually, not by Claude.' >&2; exit 2;; esac"
          }
        ]
      }
    ]
  }
}
