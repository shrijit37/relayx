# Build artifacts
/target
**/*.rs.bk

# Dependencies
node_modules/

# Environment / secrets
.env
.env.*
!.env.example
.claude/settings.local.json

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Lockfiles owned by another package manager (this repo uses bun)
pnpm-lock.yaml

# Claude Code — worktrees and machine-local runtime state
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/
.claude/agent-registry.json
.claude/agent-memory-local/
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/routines/.state/
.claude/first-run

# Web app build output
apps/web/.output/
apps/web/.wrangler/

# AI agent tooling — imported skills and tool state (not project code)
.codex/
.agents/
.forge/
.factory/
.crush/
.remember/
.opencode/hook/
.opencode/plan/
skills-lock.json

# Claude Code skills: only project-authored skills are tracked. Imported skills
# are symlinks into .agents/ (itself ignored), so committing them would leave
# dangling links on a fresh clone. The whitelist below ignores every imported
# skill automatically — add a negation when a new in-repo skill is authored.
.claude/skills/*
!.claude/skills/architecture-guard
!.claude/skills/scaffold-phase

.tmp-hook-probe.txt
