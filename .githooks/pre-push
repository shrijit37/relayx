#!/usr/bin/env bash
# Pre-push gate: file placed here (not under pack/) so `git config core.hooksPath .githooks` picks it up.
#
# Block a push (except deletions and tags) unless the full CI battery passes
# locally, mirroring `.github/workflows/ci.yml` job-for-job. The PR review
# workflow (`code-review.yml`) runs on the server and is deliberately not
# replayed here.
#
# The battery preserves CI's ordering and flags (--locked, --all-features):
#   rust policy → fmt → docs → clippy → test → msrv → web → control-plane
# PostgreSQL (for the control-plane tests) is auto-started like scripts/dev.sh
# does: the relayx-pg container is created if missing and started if stopped,
# then waited on until pg_isready. The tests themselves only create/drop
# throwaway test_* databases, so the dev `relayx` database is never touched.
#
# To print what the battery would run without running it:
#   PRE_PUSH_DRY_RUN=1 git push …
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
remote="$1"
url="$2"
dry_run="${PRE_PUSH_DRY_RUN:-0}"
dry_suffix=""
[ "$dry_run" = "1" ] && dry_suffix=" (dry run)"

# The gate's Postgres bootstrap is a throwaway db used only by the
# control-plane tests, which create/drop their own test_* databases and
# never touch the dev `relayx` database. Credentials match scripts/dev.sh
# and CI (.github/workflows/ci.yml) so the container can be shared between
# the dev stack and the gate without auth drift.

status() { printf '\n\033[1;36m==> %s%s\033[0m\n' "$*" "$dry_suffix"; }
step() { printf '    %s\n' "$*"; }

cleanup() {
  if [ -n "${failed_step:-}" ]; then
    printf '\n\033[1;31mPUSH BLOCKED by pre-push gate: %s\033[0m\n' "$failed_step" >&2
    printf '  Fix the failure and re-push. To bypass this gate deliberately,\n' >&2
    printf '  use: git push --no-verify\n' >&2
  fi
}
trap cleanup EXIT

failed_step=""
record_failure() {
  failed_step="$1"
  return 0
}

# ---------------------------------------------------------------------------
# Ref filtering
# ---------------------------------------------------------------------------
# The push payload arrives on stdin: one line per ref being pushed, as
#   <local-ref> <local-sha> <remote-ref> <remote-sha>
# Deletions and tags never trip the gate; everything else does.
has_refs=0
refs_to_check=""
branches=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_ref" ] || continue
  has_refs=1
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    printf 'SKIP: deletion push (%s) — not gated\n' "${local_ref#refs/heads/}" >&2
    continue
  fi
  case "$local_ref" in refs/heads/*) ;;
    *)
      printf 'SKIP: non-branch ref (%s) — not gated\n' "$local_ref" >&2
      continue
      ;;
  esac
  refs_to_check="${refs_to_check}${local_sha} "
  branches="${branches}${local_ref#refs/heads/}:${local_sha} "
done
if [ "$has_refs" -ne 1 ]; then
  echo "SKIP: no refs in push payload — nothing to gate"
  exit 0
fi
[ -n "$refs_to_check" ] || { echo "SKIP: no branch HEADs to gate"; exit 0; }

for sha in $refs_to_check; do
  if ! git cat-file -e "$sha^{commit}" 2>/dev/null; then
    echo "SKIP: $sha is not a commit — nothing to gate" >&2
    exit 0
  fi
done

branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo 'unknown')"
printf 'Pre-push gate: branch %s — running the CI battery locally\n' "$branch"

# ---------------------------------------------------------------------------
# Existing protection: do not push PR head branches that are behind origin/main
# (kept from the previous hook — root cause of recurring merge conflicts on
# shared files). Applied per pushed branch ref, exactly like the old hook.
# ---------------------------------------------------------------------------
if ! git fetch --quiet "$remote" 2>/dev/null; then
  echo "WARNING: Failed to fetch from '$remote'. The behind-main check may be stale."
fi
if git rev-parse --verify origin/main >/dev/null 2>&1; then
  for entry in $branches; do
    pushed_branch="${entry%%:*}"
    pushed_sha="${entry#*:}"
    # Only PR head branches (pr/*, feat/*, fix/*); skip dependabot/docs.
    [[ "$pushed_branch" =~ ^(pr/|feat/|fix/) ]] || continue
    [[ "$pushed_branch" =~ ^(dependabot/|docs/) ]] && continue
    behind=$(git rev-list --count "$pushed_sha"..origin/main 2>/dev/null || echo 0)
    if [ "$behind" -gt 0 ]; then
      cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  BLOCKED: Branch '$pushed_branch' is $behind commits behind main ║
╠══════════════════════════════════════════════════════════════╣
║                                                                ║
║  Pushing a branch that is behind main will cause merge          ║
║  conflicts on shared files (CI workflows, docs, etc.).          ║
║                                                                ║
║  Fix: rebase onto main before pushing:                          ║
║                                                                ║
║    git fetch origin                                             ║
║    git rebase origin/main                                       ║
║    git push --force-with-lease                                  ║
║                                                                ║
╚════════════════════════════════════════════════════════════════╝
EOF
      if ! git diff --quiet || ! git diff --cached --quiet; then
        echo "  WARNING: Your working tree has uncommitted changes." >&2
        echo "  Stash them before rebasing: git stash" >&2
      fi
      exit 1
    fi
  done
fi

# ---------------------------------------------------------------------------
# Diff-aware fast path
# ---------------------------------------------------------------------------
# The gate mirrors CI job-for-job, but stepping the full battery for a
# push that cannot affect a job is wasted time. Compute the pushed scope
# once and skip whole families of steps when their inputs are untouched:
#   rust_scope  — any of: *.rs, Cargo.toml, Cargo.lock, rust-toolchain.toml,
#                 rustfmt.toml, scripts/hooks/check-rust-policy.sh,
#                 .claude/hooks/check-rust-policy.sh, .factory/hooks/...
#   web_scope   — apps/web/** or any content under it
#   cp_scope    — apps/control-plane/**
#   docs_scope  — docs/**, scripts/verify-docs.sh, AGENTS.md, CLAUDE.md
# The Postgres bootstrap is still gated on cp_scope and the behind-main
# protection runs unconditionally (it is cheap).
git_scope() {
  local base="$1"; shift
  git diff --name-only "$base"...HEAD -- "$@" 2>/dev/null || true
}
if [ "$dry_run" != "1" ]; then
  scope_base="$(git merge-base HEAD origin/main 2>/dev/null || echo HEAD~1)"
  rust_scope="$(git_scope "$scope_base" '*.rs' 'Cargo.toml' 'Cargo.lock' 'rust-toolchain.toml' 'rustfmt.toml' 'scripts/hooks/check-rust-policy.sh' '.claude/hooks/check-rust-policy.sh' '.factory/hooks/check-rust-policy.sh')"
  web_scope="$(git_scope "$scope_base" 'apps/web')"
  cp_scope="$(git_scope "$scope_base" 'apps/control-plane')"
  docs_scope="$(git_scope "$scope_base" 'docs' 'scripts/verify-docs.sh' 'AGENTS.md' 'CLAUDE.md')"
  [ -n "$rust_scope" ] && step "scope: rust files changed — running Rust battery"
  [ -n "$web_scope" ] && step "scope: web changed — running web battery"
  [ -n "$cp_scope" ] && step "scope: control-plane changed — running control-plane battery"
  [ -n "$docs_scope" ] && step "scope: docs changed — running docs truth check"
  [ -z "$rust_scope$web_scope$cp_scope$docs_scope" ] && step "scope: no tracked inputs changed — skipping battery"
fi

# ---------------------------------------------------------------------------
# The battery
# ---------------------------------------------------------------------------
# Runs are bounded; a hung step (e.g. network fetch for a missing toolchain)
# aborts via the surrounding `timeout`. CI uses the same ordering.
if [ "$dry_run" = "1" ]; then
  status "PLAN — would run (in this order)"
  step "1. Postgres:      auto-start relayx-pg container on 127.0.0.1:5433 if not reachable (for step 8)"
  step "2. Rust policy:   ./.claude/hooks/check-rust-policy.sh --all"
  step "3. Rust fmt:      cargo fmt --check"
  step "4. Docs truth:    scripts/verify-docs.sh"
  step "5. Clippy:        cargo clippy --locked --all-targets --all-features --workspace -- -D warnings"
  step "6. Rust tests:    cargo test --locked --all-features --workspace"
  step "7. MSRV 1.88:     cargo +1.88.0 check --locked --all-features --workspace"
  step "8. Web:           cd apps/web && bun install && bun run typecheck && eslint (changed ts/tsx) && bun test && bun run build"
  step "9. Control plane: cd apps/control-plane && bun install && bun run typecheck && bun run test"
  exit 0
fi

# --- 9. PostgreSQL (started early; the control-plane tests need it) ---------
if [ -n "$cp_scope" ] && ! pg_isready -h 127.0.0.1 -p 5433 -q 2>/dev/null; then
  status "Postgres 127.0.0.1:5433 not reachable — starting relayx-pg"
  if ! command -v docker >/dev/null 2>&1; then
    record_failure "Postgres (steps 8) — docker not found and Postgres is not running on 127.0.0.1:5433"
    exit 1
  fi
  if docker ps -a --format '{{.Names}}' | grep -qx relayx-pg; then
    docker start relayx-pg >/dev/null
  else
    step "creating relayx-pg (postgres:16-alpine, user relayx / db relayx)"
    docker run -d --name relayx-pg \
      -p 127.0.0.1:5433:5432 \
      -e POSTGRES_PASSWORD=relayx-dev \
      -e POSTGRES_USER=relayx \
      -e POSTGRES_DB=relayx \
      postgres:16-alpine >/dev/null
  fi
  step "waiting for pg_isready (max 20s)…"
  ready=0
  for _ in $(seq 1 40); do
    if pg_isready -h 127.0.0.1 -p 5433 -q 2>/dev/null; then ready=1; break; fi
    sleep 0.5
  done
  if [ "$ready" -ne 1 ]; then
    record_failure "Postgres (steps 8) — relayx-pg did not become ready on 127.0.0.1:5433"
    exit 1
  fi
fi

# --- 1. Rust policy ----------------------------------------------------------
if [ -n "$rust_scope" ] && ! "$root/.claude/hooks/check-rust-policy.sh" --all; then
  record_failure "Rust policy"
  exit 1
fi

# --- 2. Format --------------------------------------------------------------
if [ -n "$rust_scope" ] && ! (cd "$root" && cargo fmt --check); then
  record_failure "cargo fmt --check"
  exit 1
fi

# --- 3. Docs truth ----------------------------------------------------------
if [ -n "$docs_scope" ] && ! (cd "$root" && scripts/verify-docs.sh); then
  record_failure "scripts/verify-docs.sh"
  exit 1
fi

# --- 4. Clippy --------------------------------------------------------------
if [ -n "$rust_scope" ] && ! (cd "$root" && cargo clippy --locked --all-targets --all-features --workspace -- -D warnings); then
  record_failure "cargo clippy"
  exit 1
fi

# --- 5. Rust tests ----------------------------------------------------------
if [ -n "$rust_scope" ] && ! (cd "$root" && cargo test --locked --all-features --workspace); then
  record_failure "cargo test"
  exit 1
fi

# --- 6. MSRV -----------------------------------------------------------------
if ! rustup toolchain list 2>/dev/null | grep -q '^1\.88\.0'; then
  printf '\n\033[1;31mMSRV toolchain 1.88.0 is not installed — run: rustup toolchain install 1.88.0\033[0m\n' >&2
  record_failure "MSRV toolchain 1.88.0 not installed (run: rustup toolchain install 1.88.0)"
  exit 1
fi
if [ -n "$rust_scope" ] && ! (cd "$root" && cargo +1.88.0 check --locked --all-features --workspace); then
  record_failure "MSRV check (cargo +1.88.0 check)"
  exit 1
fi

# --- 7. Web ------------------------------------------------------------------
# Web lint (changed files only) — mirrors CI's intent, resolving paths from
# inside apps/web (where eslint runs): strip the apps/web/ prefix so
# src/... paths resolve. Repo-wide lint has pre-existing debt, so we only
# gate on the PR's changed web ts/tsx files.
#
# Known toolchain issue: eslint can't load typescript-eslint under the
# repo's pinned typescript 7.0 (typescript-eslint supports TS <= 6.x).
# That is a pre-existing incompatibility, not a code violation — warn and
# continue rather than blocking pushes on it (a genuine lint violation
# still fails the gate).
lint_web() {
  local base changed_ts=() f lint_out lint_rc=0
  base="$(git merge-base HEAD origin/main 2>/dev/null || echo HEAD~1)"
  while IFS= read -r f; do
    case "$f" in apps/web/*.ts|apps/web/*.tsx) changed_ts+=("${f#apps/web/}") ;; esac
  done < <(git diff --name-only "$base"...HEAD -- '*.ts' '*.tsx' 2>/dev/null || true)
  if [ "${#changed_ts[@]}" -eq 0 ]; then
    return 0
  fi
  set +e
  lint_out="$(cd "$root/apps/web" && bunx eslint "${changed_ts[@]}" 2>&1)"
  lint_rc=$?
  set -e
  # Pre-existing toolchain incompatibility (typescript-eslint vs the pinned
  # typescript 7.0) — warn, don't block. Match the exact loader error so an
  # unrelated rule failure can never skip the gate; a genuine lint
  # violation still fails it.
  if printf '%s' "$lint_out" | rg -q "You appear to be using TypeScript [0-9]+\..*typescript-eslint|typescript-eslint does not support TS 7"; then
    step "note: web lint skipped — typescript-eslint is incompatible with the pinned typescript 7.0 (pre-existing; see node_modules/typescript-eslint)"
    return 0
  fi
  if [ -n "$lint_out" ]; then
    printf '%s\n' "$lint_out"
  fi
  return "$lint_rc"
}
if [ -n "$web_scope" ] && ! (cd "$root/apps/web" && bun install --frozen-lockfile \
  && bun run typecheck \
  && lint_web \
  && bun test \
  && bun run build); then
  record_failure "web (typecheck/lint/test/build)"
  exit 1
fi

# --- 8. Control plane --------------------------------------------------------
# `bun run test` (NOT bare `bun test`): package.json carries the flags the
# suite needs — `--timeout 20000` so DB provisioning in beforeAll cannot
# trip bun's default 5000ms hook timeout (root cause of flaky pushes).
if [ -n "$cp_scope" ] && ! (cd "$root/apps/control-plane" && bun install --frozen-lockfile \
  && bun run typecheck \
  && bun run test); then
  record_failure "control-plane (typecheck/test)"
  exit 1
fi

trap - EXIT
printf '\n\033[1;32mPre-push gate passed — pushing.\033[0m\n'
exit 0
