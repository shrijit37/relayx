# Auto-detect text files and normalize line endings
* text=auto

# Force LF for scripts and configs that break on Windows
*.sh          text eol=lf
*.bash        text eol=lf
.githooks/*   text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.toml        text eol=lf
*.json        text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.js          text eol=lf
*.jsx         text eol=lf
*.css         text eol=lf
*.html        text eol=lf
*.md          text eol=lf
*.rs          text eol=lf

# Binary files
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.woff        binary
*.woff2       binary
*.ttf         binary
*.eot         binary

# Generated files — union merge to reduce conflicts
apps/web/src/routeTree.gen.ts  merge=union

# Lock files — take theirs on conflict (regenerated by package manager)
Cargo.lock      merge=union
bun.lock        merge=union

# Linguist overrides
apps/web/src/routeTree.gen.ts  linguist-generated=true
